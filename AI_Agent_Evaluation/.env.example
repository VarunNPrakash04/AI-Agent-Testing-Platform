# Generic AI Agent Testing Platform - Environment Variables
# =========================================================
# Copy this file to .env and fill in your values.

# Application
APP_NAME=Generic AI Testing Platform
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# FastAPI Server
API_HOST=::
API_PORT=8000

# Database
DATABASE_URL=sqlite:///data/platform.db

# Streamlit
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000

# =========================================================
# LLM / Evaluation Providers
# =========================================================
# OpenAI is used by RAGAS and by many DeepEval judge workflows.
OPENAI_API_KEY=

# Optional providers if you use them in your eval setup.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Langfuse observability (optional)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# =========================================================
# Agent Authentication Tokens
# =========================================================
# HARVEST_AGENT_TOKEN=
# AUTOMATION_AGENT_TOKEN=
